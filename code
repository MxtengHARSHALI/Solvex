# code

/*
  Project Name: Smart Solar Panel Cleaning Robot
  Controller: Arduino UNO

  Components:
  - Two IR Sensors
  - L298N Motor Driver
  - 60 RPM DC Motor
  - Roller Brush Motor
  - Water Pump
*/

// IR Sensor Pins
const int irLeft = 2;
const int irRight = 3;

// L298N Motor Driver Pins
const int IN1 = 8;
const int IN2 = 9;
const int IN3 = 10;
const int IN4 = 11;

// Cleaning System Pins
const int pump = 12;
const int brush = 13;

void setup()
{
  pinMode(irLeft, INPUT);
  pinMode(irRight, INPUT);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  pinMode(pump, OUTPUT);
  pinMode(brush, OUTPUT);

  Serial.begin(9600);

  stopRobot();
  cleaningOFF();

  Serial.println("Solar Cleaning Robot Started");
}

void loop()
{
  int left = digitalRead(irLeft);
  int right = digitalRead(irRight);

  // Both sensors detect the solar panel
  if (left == LOW && right == LOW)
  {
    Serial.println("Panel Detected - Cleaning");

    forward();
    cleaningON();
  }

  // Left edge detected
  else if (left == HIGH)
  {
    Serial.println("Left Edge Detected");

    stopRobot();
    cleaningOFF();

    delay(500);

    reverse();
    delay(1000);

    stopRobot();
  }

  // Right edge detected
  else if (right == HIGH)
  {
    Serial.println("Right Edge Detected");

    stopRobot();
    cleaningOFF();

    delay(500);

    reverse();
    delay(1000);

    stopRobot();
  }

  else
  {
    stopRobot();
    cleaningOFF();
  }
}

// Move Forward
void forward()
{
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}

// Move Backward
void reverse()
{
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}

// Stop Robot
void stopRobot()
{
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);

  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}

// Start Cleaning
void cleaningON()
{
  digitalWrite(brush, HIGH);
  digitalWrite(pump, HIGH);
}

// Stop Cleaning
void cleaningOFF()
{
  digitalWrite(brush, LOW);
  digitalWrite(pump, LOW);
}
